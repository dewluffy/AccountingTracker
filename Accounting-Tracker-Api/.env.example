PORT=8000

# Database (used by src/config/prisma.js via @prisma/adapter-mariadb)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=accounting_tracker

# Database (used by prisma.config.ts for `prisma db push` / migrations)
DATABASE_URL="mysql://root:@localhost:3306/accounting_tracker"

# Auth
JWT_SECRET=change-me-to-a-long-random-string
